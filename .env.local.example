# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Ricardo CRM financial feed (optional — job detail hides the panel if unset).
# Anon key of the Ricardo Supabase project + the shared secret stored in its
# erp_integration_config table (see erp_job_financials migration there).
RICARDO_SUPABASE_URL=https://ricardo-project.supabase.co
RICARDO_SUPABASE_ANON_KEY=ricardo-anon-key-here
RICARDO_ERP_SECRET=shared-secret-here
