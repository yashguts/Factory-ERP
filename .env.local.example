# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Ricardo CRM financial feed (optional — job detail hides the panel if unset).
# Anon key of the Ricardo Supabase project + the shared secret stored in its
# erp_integration_config table (see erp_job_financials migration there).
RICARDO_SUPABASE_URL=https://ricardo-project.supabase.co
RICARDO_SUPABASE_ANON_KEY=ricardo-anon-key-here
RICARDO_ERP_SECRET=shared-secret-here

# LT Elevator CRM feed — same contract as Ricardo's (erp_job_financials + erp_job_gst).
LTCRM_SUPABASE_URL=https://ltcrm-project.supabase.co
LTCRM_SUPABASE_ANON_KEY=ltcrm-anon-key-here
LTCRM_ERP_SECRET=shared-secret-here

# The factory's own coordinates (decimal degrees) — OPTIONAL override. The CRM panel on a job
# shows the site's geotag (from LT Construction's site measurement / survey / final audit) and its
# straight-line distance from the factory for transport planning. Unset = the Chak Chatta factory
# as LT AMC's office_location has it (22.48535, 88.25599; src/lib/geo/distance.ts FACTORY_DEFAULT).
# FACTORY_LAT=22.48535
# FACTORY_LNG=88.25599
